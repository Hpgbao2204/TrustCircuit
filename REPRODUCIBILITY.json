{
  "schema": "TrustCircuit.ReproducibilityManifest.v1",
  "archive_policy": {
    "tracked": [
      "source code and tests",
      "dependency locks and build configuration",
      "public input dataset",
      "canonical raw experiment evidence",
      "canonical Base Sepolia evidence"
    ],
    "regenerated_not_tracked": [
      "processed CSV and JSON summaries",
      "paper sources and generated figures",
      "transient per-request bundles",
      "build outputs and downloaded tools",
      "local machine state and credentials"
    ],
    "raw_values_modified_during_packaging": false
  },
  "measurement_classes": {
    "measured": "direct structured timing from an executed implementation",
    "locally_measured": "direct measurement on the recorded local host",
    "measured_paired": "paired Native and VBS execution over byte-identical encrypted requests",
    "measured_local_hardhat": "direct local Hardhat timing or transaction receipt",
    "measured_with_analytical_margin": "measured fixed-point result compared with an analytical oracle",
    "measured_public_testnet": "direct Base Sepolia transaction and receipt evidence",
    "measured_summary_declared_by_config": "summary generated by the measured ZK runner; the CSV has no row-level measurement_type column",
    "functional_test_evidence": "classification backed by named passing rejection tests",
    "functional_definition": "declared capability definition, not a performance measurement",
    "analytical_from_measured_cost": "analytical composition based on a measured fixed-point cost",
    "model_calibrated_from_measured_components": "model output composed only from separately measured components"
  },
  "reproduction_commands": {
    "tests": "npm test",
    "process_raw_results": "python scripts/process_phase8_results.py",
    "generate_figures": "python scripts/plot_all_results.py",
    "full_experiment_suite": "npm run phase8:experiments"
  },
