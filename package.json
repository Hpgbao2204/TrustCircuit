{
  "name": "trust-circuit-kltn",
  "version": "0.1.0",
  "private": true,
  "description": "TrustCircuit: request-bound settlement of privacy-preserving data use with Groth16 compliance proofs, ledger-enforced RDP accounting, and a k-of-n validator quorum.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "lint": "node scripts/check_source_syntax.js",
    "zk:build": "node zk/scripts/ceremony_v3.js build",
    "zk:status": "node zk/scripts/ceremony_v3.js status",
    "bench:vcp": "hardhat run zk/scripts/benchmark_vcp_v3.js",
    "bench:attacks": "hardhat run scripts/experiments/run_attack_matrix.js",
    "bench:gas": "hardhat run scripts/experiments/run_gas_benchmarks.js",
    "bench:network": "python analysis/network_model.py",
    "bench:dp": "python dp/experiment.py",
    "bench:cpabe": "python crypto/run_cpabe_policy_benchmark.py",
    "bench:hybrid": "node crypto/abe_scaling.js",
    "bench:aes": "python crypto/run_aes_gcm_scaling.py",
    "testnet:smoke": "node benchmarks/base_sepolia_v3.js --smoke",
    "testnet": "node benchmarks/base_sepolia_v3.js",
    "plot": "python benchmarks/plot_base_sepolia_v3.py && python benchmarks/plot_privacy_access.py && python tee/nitro/plot_nitro_results.py"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "hardhat": "^2.22.0",
    "snarkjs": "0.7.5"
  },
  "dependencies": {
    "ethers": "^6.13.0"
  }
}
